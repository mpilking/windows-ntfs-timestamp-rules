# Third-party binaries are downloaded by provision/Get-Tools.ps1 and verified
# against pinned hashes. They are never vendored: separate licenses, independent
# release cadence, and "which version produced this result" must stay auditable.
tools/*
!tools/tool-hashes.json

# Working scratch. Published results live under results/<build>/ and are
# committed deliberately, not swept in by a wildcard.
scratch/
*.tmp

# VHDX test volumes are regenerated by provision/New-TestVolumes.ps1.
# Archived evidence volumes are committed by explicit path only.
*.vhdx
*.vhd

# Installation media
*.iso

# Editor / OS noise
.vscode/
Thumbs.db
desktop.ini
~$*
